generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  PROCESS
  BANNED
  DELETED
}

model UserProfile {
  id        Int        @id // userId from Auth Service
  email     String     @unique
  firstName String?
  lastName  String?
  avatarUrl String?
  role      Role       @default(USER)
  status    UserStatus @default(ACTIVE)
  bio       String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@map("user-profiles")
}
